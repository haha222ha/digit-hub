[Unit]
Description=XHS V2 Insight Report Shadow (PG to insight_shadow, L0 precompute)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
User=admin
WorkingDirectory=/opt/xhs-cloud
EnvironmentFile=-/opt/xhs-cloud/.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/xhs-cloud
Environment=XHS_INSIGHT_SHADOW=1
ExecStart=/bin/bash /opt/xhs-cloud/cloud_deploy/scripts/run_insight_report_shadow.sh

[Install]
WantedBy=multi-user.target
