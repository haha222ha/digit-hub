[Unit]
Description=XHS Advisor daily three-question health check
After=network.target xhs-cloud-api.service

[Service]
Type=oneshot
User=admin
WorkingDirectory=/opt/xhs-cloud
EnvironmentFile=-/opt/xhs-cloud/.env
ExecStart=/bin/bash /opt/xhs-cloud/cloud_deploy/scripts/launch_advisor_health.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
