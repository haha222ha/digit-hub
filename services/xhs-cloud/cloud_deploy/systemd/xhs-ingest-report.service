[Unit]
Description=XHS Monitor Report Ingest (data.js → PG + zip)
After=network.target postgresql.service

[Service]
Type=oneshot
User=admin
WorkingDirectory=/opt/xhs-cloud
EnvironmentFile=-/opt/xhs-cloud/.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/xhs-cloud
ExecStart=/opt/xhs-cloud/venv/bin/python /opt/xhs-cloud/cloud_deploy/scripts/run_daily_pipeline.py

[Install]
WantedBy=multi-user.target
