[Unit]
Description=XHS A/B Test Daily (Feature Engine vs 100% AI)
After=network.target xhs-cloud-api.service

[Service]
Type=oneshot
User=admin
WorkingDirectory=/opt/xhs-cloud
ExecStart=/bin/bash /opt/xhs-cloud/cloud_deploy/scripts/run_ab_test_daily.sh
StandardOutput=append:/var/log/xhs-ab-test.log
StandardError=append:/var/log/xhs-ab-test.log
TimeoutStartSec=600
