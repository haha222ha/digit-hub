        "无": "作为Beta，你的信息素几乎无法被感知，也不受任何信息素控制，始终保持着清醒的自我意志。"
      };
      const phSub = pheromoneSubtitles[result.pheromone] || "";
      if (result.pheromone === "无") {
        document.getElementById("pheromoneLine").textContent = "无信息素，也不受任何信息素控制";
      } else {
        document.getElementById("pheromoneLine").textContent = phSub ? `${result.pheromone} – ${phSub}` : result.pheromone;
