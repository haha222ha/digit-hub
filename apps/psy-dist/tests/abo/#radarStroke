      }

      if (!window.linkValidator) {
        console.error("SDK未初始化，无法开始测试");
        alert("验证SDK未初始化，无法开始测试。请刷新页面重试。");
        return;
      }

      let isValid = false;
      if (typeof window.linkValidator.validateForUserAction === "function") {
        try {
          isValid = await window.linkValidator.validateForUserAction();
          if (!isValid || window.linkValidator.valid === false) {
            console.warn("链接验证失败，无法开始测试");
            return;
          }
        } catch (error) {
          console.error("链接验证失败:", error);
          if (window.linkValidator) {
            window.linkValidator.valid = false;
          }
          return;
        }
      } else {
        if (window.linkValidator.valid === false) {
          alert(window.linkValidator.validationError || "测试链接无效，请检查链接是否正确");
          return;
        }
        isValid = window.linkValidator.valid !== false;
      }

      if (!isValid || window.linkValidator.valid === false) {
        console.warn("最终验证检查失败，无法开始测试");
        return;
      }

      const urlParams = new URLSearchParams(window.location.search);
      const isRestart = urlParams.get("restart") === "true";

      if (!isRestart && !window.__abo_test_started) {
        try {
          window.__abo_test_started = true;
          await window.linkValidator.startTest();
          console.log("测试开始记录成功");
        } catch (error) {
          console.error("记录测试开始失败:", error);
          window.__abo_test_started = false;
          return;
        }
      } else if (isRestart) {
        console.log("重新测试模式，跳过startTest()调用，避免重复扣除次数");
        window.__abo_test_started = false;
        window.__abo_test_completed = false;
      }

      state.index = 0;
      state.answers = Array(DATA.questions.length).fill(null);
      state.transitioning = false;
      switchScreen(quizScreen);
      renderQuestion();
    });
    prevBtn.addEventListener("click", () => {
      if (!state.transitioning && state.index > 0) {
        state.index -= 1;
        renderQuestion();
      }
    });
    document.getElementById("restartBtn").addEventListener("click", () => {
      if (window.linkValidator && typeof window.linkValidator.clearLocalResult === "function") {
        window.linkValidator.clearLocalResult();
      }

      const urlParams = new URLSearchParams(window.location.search);
      let token = urlParams.get("token");
      if (!token && window.linkValidator && window.linkValidator.token) {
        token = window.linkValidator.token;
      }

      if (token) {
        const newUrlParams = new URLSearchParams();
        newUrlParams.set("token", token);
        newUrlParams.set("restart", "true");
        if (urlParams.get("unlimited") === "true" || (window.linkValidator && window.linkValidator.unlimited)) {
          newUrlParams.set("unlimited", "true");
        }
        window.location.href = window.location.pathname + "?" + newUrlParams.toString();
        return;
      }

      state.index = 0;
      state.answers = Array(DATA.questions.length).fill(null);
      state.transitioning = false;
      window.__abo_test_started = false;
      window.__abo_test_completed = false;
      document.body.classList.remove("theme-alpha", "theme-beta", "theme-omega");
      const resultEl = document.querySelector("#resultScreen .result");
      if (resultEl) resultEl.classList.remove("theme-alpha", "theme-beta", "theme-omega");
      switchScreen(homeScreen);
    });

  </script>

  <script src="/static/js/link-validator.js"></script>
  <script>
    if (typeof TestSecurity !== "undefined") {
      TestSecurity.enable();
    }

    let validatorInstance = null;

    if (typeof PsyTestValidator !== "undefined") {
      PsyTestValidator.init("abo", {
        onSuccess: function(result, validator) {
          console.log("SDK初始化成功，链接有效:", result);
          validatorInstance = validator;
          window.linkValidator = validator;
          document.body.classList.remove("page-disabled");
        },
        onError: function(error) {
          console.error("SDK初始化失败，链接无效:", error);
          if (window.PsyTestValidator && typeof window.PsyTestValidator.getInstance === "function") {
            validatorInstance = window.PsyTestValidator.getInstance();
            window.linkValidator = validatorInstance;
          }
          document.body.classList.remove("page-disabled");
        },
        onLoad: function(data) {
          console.log("SDK加载完成回调:", data);
          if (!validatorInstance) {
            if (window.PsyTestValidator && typeof window.PsyTestValidator.getInstance === "function") {
              validatorInstance = window.PsyTestValidator.getInstance();
            }
            if (validatorInstance) {
              window.linkValidator = validatorInstance;
            }
          }
          document.body.classList.remove("page-disabled");

          setTimeout(() => {
            if (typeof PsyTestValidator !== "undefined" && typeof PsyTestValidator.addPromotionLink === "function") {
              PsyTestValidator.addPromotionLink();
            }
          }, 100);

          const urlParams = new URLSearchParams(window.location.search);
          const isRestart = urlParams.get("restart") === "true";

          if (isRestart) {
            if (validatorInstance && typeof validatorInstance.clearLocalResult === "function") {
              validatorInstance.clearLocalResult();
            }
            window.__abo_test_started = false;
            window.__abo_test_completed = false;
            urlParams.delete("restart");
            const newUrl = window.location.pathname + (urlParams.toString() ? "?" + urlParams.toString() : "");
            window.history.replaceState({}, "", newUrl);
            return;
          }

          if (data.valid && data.has_local_result) {
            const saved = validatorInstance && typeof validatorInstance.getLocalResult === "function"
              ? validatorInstance.getLocalResult()
              : null;
            if (saved && window.__abo_restoreResult && window.__abo_restoreResult(saved)) {
              console.log("检测到本地结果，已恢复到结果页");
              return;
            }
          }
        }
      });
    } else {
      console.error("验证SDK未加载");
      document.body.classList.remove("page-disabled");
    }
  </script>
</body>
</html>
