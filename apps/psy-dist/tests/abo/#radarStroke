        .slice(0, 3)
        .map(c => c.name);
      const darkValue = darkTopChips.length > 1 ? darkTopChips : result.dark.type;
      const tempTopChips = result.temperament.components
        .filter(c => c.score >= 50)
        .sort((a, b) => b.score - a.score)
        .slice(0, 3)
        .map(c => c.name);
      const tempValue = tempTopChips.length > 1 ? tempTopChips : result.temperament.type;
      const items = [
        { label: "心理性别/ABO属性", value: [`${result.psychoGender}·${result.abo}`, `信息素：${result.pheromone}`], desc: psychoDesc(result.psychoGender) + aboDesc(result.abo) + "\n\n" + (result.pheromone === "无" ? "作为Beta，你的信息素几乎无法被感知，也不受任何信息素控制，始终保持着清醒的自我意志。" : getDesc(result.pheromone)) },
        { label: "黑化成分", value: darkValue, desc: result.dark.desc, bars: renderPercentBars(result.dark.components, 50, "dark") },
        { label: "气质", value: tempValue, desc: result.temperament.desc, bars: renderPercentBars(result.temperament.components, 40, "temperament") },
        { label: "动物系", value: `${result.animal}系`, desc: getDesc(result.animal) },
        { label: "社交属性", value: result.social, desc: getDesc(result.social) },
        { label: "依恋类型", value: result.attachment, desc: getDesc(result.attachment) }
      ];
      document.getElementById("resultGrid").innerHTML = items.map((item, idx) => `
        <article class="result-item" style="animation-delay:${idx * 70}ms">
          <div class="item-head">
            <div class="item-label">${escapeHtml(item.label)}</div>
            <div class="item-value">${renderValueChips(item.label, item.value)}</div>
