    async function showResult() {
      if (state.answers.some(v => !v)) {
        showToast("还有题目未完成，请先全部作答");
        return;
      }
      const scores = calcScores();
      const result = judge(scores);
      renderArchive(result, scores);

      const testResult = {
        result,
        scores,
        answers: state.answers.slice(),
        profile: `${result.psychoGender}·${result.abo}·${result.animal}系`,
        rarity: result.rarity,
        overview: result.overview,
        completedAt: new Date().toISOString()
      };

      if (window.linkValidator && !window.__abo_test_completed) {
        try {
          window.__abo_test_completed = true;
          await window.linkValidator.completeTest(undefined, testResult);
          console.log("测试完成记录成功");
          if (window.linkValidator) {
            window.linkValidator.valid = true;
          }
        } catch (error) {
          console.error("记录测试完成失败:", error);
          window.__abo_test_completed = false;
          // 失败时不强制 valid=true，避免绕过服务端解锁
        }
      }
    }

    window.__abo_restoreResult = function(saved) {
      if (!saved || !saved.result || !saved.scores) return false;
      renderArchive(saved.result, saved.scores);
      window.__abo_test_completed = true;
      return true;
    };

    function aboDesc(type) {
