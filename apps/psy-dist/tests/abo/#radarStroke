      // ---------- 5. 动物系（直标百分比法：选项→动物累计分→百分比→取最高） ----------
      const animal = calcAnimalByScoring();

      // 归一化维度（用于信息素、黑化、气质等后续计算）
      const n = { D: norm(D), S: norm(S), St: norm(St), So: norm(So), W: norm(W), Da: norm(Da) };

      // ---------- 6. 信息素气味（Beta无信息素，其他用直标百分比法选取） ----------
      let pheromone;
      if (abo === "Beta") {
        pheromone = "无";
      } else {
        pheromone = calcPheromoneByScoring();
      }

      // ---------- 7. 依恋类型（按得分权重确定性选取，加保底避免全0） ----------
      const attachment = drawByScore({
        "安全型": Math.max(0.05, 0.4 * n.St + 0.3 * (1 - n.Da) + 0.3 * (1 - Math.abs(n.S - 0.5))),
        "焦虑型": Math.max(0.05, 0.5 * n.S + 0.3 * (1 - n.St) + 0.2 * (1 - n.Da)),
        "回避型": Math.max(0.05, 0.4 * (1 - n.S) + 0.3 * n.St + 0.3 * (1 - n.Da)),
        "恐惧型": Math.max(0.05, 0.4 * n.Da + 0.3 * n.S + 0.3 * (1 - n.St))
      });

      // ---------- 8. 黑化成分（复用 n 对象） ----------
      const dark = calcDarkProfile(n, attachment, scores);

      // ---------- 9. 气质（复用 n 对象） ----------
      const temperament = calcTemperamentProfile(n);

      // ---------- 10. 概述 ----------
      const overview = overviewResult({ abo, rarity, dark, Da });

      return { psychoGender, abo, rarity, social, animal, dark, pheromone, temperament, attachment, overview };
    }

    function drawByScore(scoreMap) {
      const keys = Object.keys(scoreMap);
      if (!keys.length) return "";
      let bestName = keys[0];
      let bestScore = -Infinity;
      for (const [name, score] of Object.entries(scoreMap)) {
        if (score > bestScore) { bestScore = score; bestName = name; }
      }
      return bestName;
    }

    function norm(value) {
      return Math.min(1, Math.max(0, value / 50));
    }

    function pctScore(value) {
      return Math.max(0, Math.min(100, Math.round(value * 100)));
    }

    function component(name, score) {
      return { name, score: pctScore(score) };
    }

    function calcDarkProfile(n, attachment, scores) {
      const { D, Da, S } = scores;
      const components = [
        component("疯批", 0.8 * n.Da + 0.2 * (1 - n.St)),
        component("病娇", 0.4 * n.S + 0.3 * n.Da + 0.2 * (1 - n.St) + (attachment === "焦虑型" ? 0.1 : 0)),
        component("腹黑", (D >= 20 && Da >= 15 ? 0.4 : 0) + 0.4 * n.Da + 0.5 * n.D + 0.1 * (1 - n.S)),
        component("抖M", (0.5 * (1 - n.D) + 0.35 * n.S + 0.35 * (1 - n.Da)) * Math.pow(1 - n.St, 2)),
        component("抖S", 0.6 * n.D + 0.3 * n.Da + 0.3 * (1 - n.S)),
        component("自恋", 0.3 * n.D + 0.3 * n.So + 0.6 * (1 - n.S)),
        component("绿茶", 0.3 * n.S + 0.2 * n.So + 0.2 * (1 - n.D) + 0.3 * (1 - n.Da)),
        component("傲娇", 0.35 * n.D + 0.35 * n.S + 0.2 * (1 - n.So) + 0.2 * (1 - n.Da))
      ];
      const ranked = [...components].sort((a, b) => b.score - a.score);
      const [top, second] = ranked;
      const allBelow = limit => components.every(item => item.score < limit);
      const ge50Count = components.filter(c => c.score >= 50).length;
      const darkDescriptions = {
        疯批: "你的理智与疯狂只有一线之隔。你享受在失控边缘试探，让人畏惧又着迷。",
        病娇: "你的爱浓烈到灼人，害怕失去所以想要掌控。你渴望绝对的占有，却常因此受伤。",
        腹黑: "你习惯藏起真实意图，暗中布局。你喜欢掌控节奏，享受运筹帷幄的快感。",
        抖M: "你潜意识里享受被压制，从卑微或疼痛中获得扭曲的安心。",
        抖S: "你喜欢支配他人，从控制中获得快感。你享受臣服的目光。",
        自恋: "你极度关注自我，渴望成为焦点。你相信自己与众不同。",
        绿茶: "你习惯用柔软的外壳保护自己，以退为进。你以为藏得很好，其实早已被看穿。",
        傲娇: "你口是心非，明明关心却嘴硬。你怕先伸出手会被拒绝，所以总是推开。",
        复合暗影: "你的暗黑面复杂多元，多种特质交织。你无法被单一标签定义。",
        温和无黑化: "你几乎没有暗黑倾向，平和通透。这是难得的心理韧性。"
      };
      let type = top.name;
      if (allBelow(50)) {
        type = "温和无黑化";
      } else if (ge50Count >= 3) {
        type = top.name;
      } else if (top.score - second.score < 10 && top.score >= 50 && second.score >= 50) {
        type = "复合暗影";
      }
      const desc = darkDescriptions[type] || darkDescriptions[top.name];
      return { type, desc, top: top.name, components };
    }

    function calcTemperamentProfile(n) {
      const components = [
        component("霸气", 0.55 * n.D + 0.25 * n.Da + 0.2 * n.W),
        component("温柔", 0.5 * n.S + 0.25 * (1 - n.D) + 0.25 * n.St),
        component("清冷", 0.25 * n.St + 0.25 * (1 - n.S) + 0.25 * n.So + 0.25 * (1 - n.Da)),
        component("妖冶", 0.45 * n.S + 0.35 * n.Da + 0.2 * n.W + 0.05),
        component("可靠", 0.45 * n.St + 0.3 * n.D + 0.25 * n.W + 0.05),
        component("随和", 0.25 * n.So + 0.25 * (1 - n.Da) + 0.25 * n.S + 0.25 * n.W)
      ];
      const ranked = [...components].sort((a, b) => b.score - a.score);
      const [top, second] = ranked;
      const ge50Count = components.filter(c => c.score >= 50).length;
      const descriptions = {
        霸气: "你自带强大的气场，习惯主导和决策。你不怒自威，让人信服也让人敬畏。你享受掌控，也承担着相应的责任。",
        温柔: "你像春风化雨，总能让人感到舒适和被理解。你不喜冲突，善于倾听。你的柔和不是软弱，而是深刻的包容。",
        清冷: "你与人群保持着距离，情绪内敛，不轻易示人。你喜欢独处，内心丰富而安静。懂你的人虽少，但你并不孤独。",
        妖冶: "你身上有一种危险又迷人的气质，举手投足间带着蛊惑。你擅长用魅力影响他人，让人又爱又怕，欲罢不能。",
        可靠: "你是让人安心的存在，言出必行，沉稳担当。朋友遇到困难总会想到你。你未必耀眼，但不可或缺。",
        随和: "你心态平和，不争不抢，容易相处。你适应力强，随遇而安，是朋友圈里的“稳定器”。你不给人压力，自己也很轻松。",
        融合气质: "你的气质复杂而平衡，融合了多种特质。你刚柔并济，在不同人面前展现不同面貌，令人难以捉摸。",
        平淡气质: "你的气质中庸内敛，没有极端倾向。你像水一样，随容器而变，适应大多数环境。"
      };
      let type = top.name;
      if (top.score < 30) {
        type = "平淡气质";
      } else if (ge50Count >= 3) {
        type = top.name;
      } else if (top.score - second.score < 10 && top.score >= 50 && second.score >= 50) {
        type = "融合气质";
      }
      return { type, desc: descriptions[type], top: top.name, components };
    }

    function overviewResult(result) {
      const darkComponents = (result.dark && result.dark.components) || [];
      const highlightedDark = darkComponents.filter(item => item.score >= 50).map(item => item.name);
      if ((highlightedDark.includes("傲娇") || highlightedDark.includes("绿茶")) && result.Da < 16) return "傲娇/绿茶";
      if (result.Da >= 20) return "黑化修罗场";
      if (result.rarity === "传说" && result.abo === "Alpha") return "传说级王者";
      if (result.rarity === "泛滥" && result.Da <= 5) return "佛系路人";
      if (["传说", "稀有", "罕见", "常见"].includes(result.rarity) && result.abo === "Omega" && result.Da >= 12 && result.Da <= 19) return "暗夜诱惑";
      if (["稀有", "罕见", "常见"].includes(result.rarity) && result.abo === "Alpha" && result.Da >= 12 && result.Da <= 19) return "稀有领袖";
      if (result.abo === "Alpha" && result.Da <= 11) return "温和守护者";
      if (result.abo === "Omega" && result.Da <= 11) return "治愈系甜心";
      if (result.abo === "Beta" && result.Da >= 16) return "神秘中间者";
      if (result.abo === "Beta" && result.Da <= 15) return "人间清醒";
      return "矛盾综合体";
    }

    function getDesc(name) {
      if (!name || typeof name !== "string") return "";
      if (DATA.descriptions[name]) return DATA.descriptions[name];
      var stripped = name.replace(/（.*?）/g, "");
      if (DATA.descriptions[stripped]) return DATA.descriptions[stripped];
      for (var k in DATA.descriptions) {
        if (k.replace(/（.*?）/g, "") === stripped) return DATA.descriptions[k];
      }
      return "";
    }

    function getValueTone(label, value) {
      if (typeof value === "string" && value.startsWith("信息素：")) return "tone-scent";
      if (label.includes("心理性别")) return "tone-profile";
      if (label === "信息素气味") return "tone-scent";
      if (label === "动物系") return "tone-animal";
      if (label === "社交属性") return "tone-social";
      if (label === "黑化成分") return "tone-dark";
      if (label === "气质") return "tone-temperament";
      if (label === "依恋类型") return "tone-attachment";
      return "";
    }

    function renderRadarChart(scores) {
      const order = ["D", "S", "St", "So", "W", "Da"];
      const labels = {
        D: "支配性",
        S: "敏感性",
        St: "稳定性",
        So: "社交性",
        W: "野性",
        Da: "黑暗倾向"
      };
      const cx = 160;
      const cy = 160;
      const radius = 82;
      const maxScore = Math.max(30, ...order.map(key => scores[key]));
      const point = (idx, valueRadius) => {
        const angle = -Math.PI / 2 + idx * Math.PI * 2 / order.length;
        return [
          cx + Math.cos(angle) * valueRadius,
          cy + Math.sin(angle) * valueRadius
        ];
      };
      const polygon = scale => order.map((_, idx) => point(idx, radius * scale).join(",")).join(" ");
      const scorePoints = order.map((key, idx) => {
        const safeValue = Math.max(0, scores[key]);
        return point(idx, radius * Math.min(1, safeValue / maxScore));
      });
      const scorePolygon = scorePoints.map(p => p.join(",")).join(" ");
      const axisLines = order.map((key, idx) => {
        const [x, y] = point(idx, radius);
        return `<line class="radar-axis" x1="${cx}" y1="${cy}" x2="${x.toFixed(1)}" y2="${y.toFixed(1)}"></line>`;
      }).join("");
      const dots = scorePoints.map(([x, y]) => `<circle class="radar-dot" cx="${x.toFixed(1)}" cy="${y.toFixed(1)}" r="4.5"></circle>`).join("");
      const labelNodes = order.map((key, idx) => {
        const [lx, ly] = point(idx, radius + 43);
        return `
          <text class="radar-label" x="${lx.toFixed(1)}" y="${ly.toFixed(1)}" text-anchor="middle" dominant-baseline="middle">${labels[key]}：${Math.max(0, scores[key])}</text>
        `;
      }).join("");
      const grid = [0.25, 0.5, 0.75, 1].map(scale => `<polygon class="radar-grid" points="${polygon(scale)}"></polygon>`).join("");
      return `
        <div class="radar-chart-wrap">
          <svg class="radar-svg" viewBox="0 0 320 320" role="img" aria-label="六个维度分数雷达图" style="--radar-scale:0">
            <defs>
              <linearGradient id="radarStroke" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#c9a87c"></stop>
                <stop offset="100%" stop-color="#8b2038"></stop>
              </linearGradient>
            </defs>
            ${grid}
            ${axisLines}
            <polygon class="radar-area" points="${scorePolygon}"></polygon>
            ${dots}
            ${labelNodes}
          </svg>
        </div>
      `;
    }

    function renderPercentBars(components, threshold, tone) {
      return `
        <div class="score-bars">
          ${components.map(item => {
            const highlighted = item.score >= threshold;
            return `
              <div class="score-bar ${highlighted ? "is-highlight" : ""}">
                <div class="score-bar-head">
                  <span>${escapeHtml(item.name)}</span>
                  <span class="score-bar-percent">${item.score}%</span>
                </div>
                <div class="score-bar-track" aria-hidden="true">
                  <div class="score-bar-fill ${highlighted ? `is-highlight ${tone}` : ""}" style="--pct:${item.score}%"></div>
                </div>
              </div>
            `;
          }).join("")}
        </div>
      `;
    }

    function renderValueChips(label, value) {
      if (Array.isArray(value)) {
        return value.map(v => `<span class="value-chip ${getValueTone(label, v)}">${escapeHtml(v)}</span>`).join("");
      }
      return `<span class="value-chip ${getValueTone(label, value)}">${escapeHtml(value)}</span>`;
    }

    function animateRadarChart() {
      const svg = document.querySelector(".radar-svg");
      if (!svg) return;
      const start = performance.now();
      const duration = 920;
      function step(now) {
        const progress = Math.min(1, (now - start) / duration);
        const eased = 1 - Math.pow(1 - progress, 3);
        svg.style.setProperty("--radar-scale", eased.toFixed(3));
        if (progress < 1) requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
    }

    function renderArchive(result, scores) {
